# Isolate HOME so parallel aitools tests don't race on a shared ~/.databricks.
sethome home
mkdir -p "${USERPROFILE:-$HOME}/.cursor"

title "invalid flag combination fails before any step\n"
errcode $CLI aitools install --skills-only --path out
trace print_telemetry

title "unknown agent fails after the scope step\n"
errcode $CLI aitools install --skills-only --scope=global --agents=no-such-agent
trace print_telemetry

title "a skill missing from the manifest fails after the plan is confirmed\n"
errcode $CLI aitools install --skills-only --scope=global --agents=cursor --skills=nonexistent
trace print_telemetry

title "a manifest the server does not have is MANIFEST_NOT_FOUND\n"
errcode env DATABRICKS_SKILLS_REF=missing-ref $CLI aitools install --skills-only --scope=global --agents=cursor
trace print_telemetry

title "any other HTTP error status from the manifest fetch is SKILLS_FETCH_FAILED\n"
errcode env DATABRICKS_SKILLS_REF=broken-ref $CLI aitools install --skills-only --scope=global --agents=cursor
trace print_telemetry

title "a named agent skipped for the scope takes its category from the agent's outcome\n"
errcode $CLI aitools install --skills-only --scope=project --agents=cursor
trace print_telemetry

title "a --path dump that writes no skill exits 0 but finishes as FAILURE, with no SKILLS_DUMPED step\n"
trace env DATABRICKS_SKILLS_REF=experimental-ref $CLI aitools install --path dump
trace print_telemetry
